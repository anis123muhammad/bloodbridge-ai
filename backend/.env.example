# Copy to .env and fill in. Never commit .env.

# --- Database ---
# Local dev with docker-compose.dev.yml:
DATABASE_URL=postgresql+psycopg://bloodbridge:bloodbridge@localhost:5432/bloodbridge
# Inside the production docker-compose network the host is the service name, e.g.:
# DATABASE_URL=postgresql+psycopg://bloodbridge:<password>@db:5432/bloodbridge

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS: comma-separated frontend origins ---
CORS_ORIGINS=http://localhost:3000

# --- Vultr Serverless Inference (optional) ---
# Leave the key empty to run fully on deterministic rules.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Pick a chat/instruct model from GET /v1/models with your key
VULTR_INFERENCE_MODEL=

# --- Workflow rules (operational, not medical) ---
APP_TIMEZONE=Asia/Karachi
MATCHING_RADIUS_STEPS_KM=25,50,100
MAX_CANDIDATES=8
MIN_DAYS_BETWEEN_DONATIONS_DEMO=90
INVITATION_TIMEOUT_MINUTES=30
FOLLOW_UP_INTERVAL_SECONDS=60
ENABLE_BACKGROUND_FOLLOW_UP=true
